# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://milano-pizzeria-duisburg.de
NODE_ENV=production
CUSTOM_KEY=your-custom-key

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/milano_pizzeria?sslmode=require

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long

# ─── Email (SMTP / Gmail) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@milano-pizzeria-duisburg.de
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@milano-pizzeria-duisburg.de

# ─── Stripe Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<your-stripe-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ─── PayPal ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_BASE_URL=https://api-m.paypal.com

# ─── Google Maps ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_SITE_VERIFICATION=your-google-verification-code

# ─── Google Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Cloudinary (Image Upload) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── Redis (Optional — for rate limiting & sessions) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── WhatsApp Business API (Optional) ────────────────────────────────────────
WHATSAPP_PHONE=+4920312345677
NEXT_PUBLIC_WHATSAPP_PHONE=+4920312345677
